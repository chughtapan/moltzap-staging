{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "rootDir": "src",
    "customConditions": [
      "sharness-internal"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.types-check.ts",
    "src/**/__tests__",
    "dist",
    "src/test.ts"
  ],
  "references": [
    {
      "path": "../social-harness"
    }
  ]
}
