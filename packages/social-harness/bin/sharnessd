#!/usr/bin/env node
import { NodeRuntime } from "@effect/platform-node";
import { ConfigProvider, Console, Effect, Layer } from "effect";
import { daemonHelp, daemonLayer } from "../dist/harness/startup.js";

const args = process.argv.slice(2);
const program = Effect.suspend(() => {
  if (args.length === 1 && args[0] === "--help") {
    return Console.log(daemonHelp);
  }
  if (args.length === 0) {
    return Layer.launch(daemonLayer);
  }
  return Console.error(daemonHelp).pipe(
    Effect.andThen(Effect.sync(() => { process.exitCode = 1; })),
  );
});

program.pipe(
  Effect.catchAll((error) => Console.error(
    error._tag === "DaemonConfigurationError" ||
    error._tag === "DatabaseAccessError" ||
    error._tag === "DatabasePreparationError"
      ? error.message
      : "The daemon could not start. Check SHARNESS_CONFIG_FILE, SHARNESS_DATABASE_URL and SHARNESS_DATABASE_KEY; run sharnessd --help for what each must hold.",
  ).pipe(
    Effect.andThen(Effect.sync(() => { process.exitCode = 1; })),
  )),
  Effect.withConfigProvider(ConfigProvider.fromEnv()),
  NodeRuntime.runMain,
);
