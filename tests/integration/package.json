{
  "name": "@social-harness/integration-tests",
  "private": true,
  "description": "Cross-package process acceptance suites",
  "type": "module",
  "scripts": {
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint . --cache --max-warnings=0",
    "test:live": "node --conditions=sharness-test --import tsx --test --test-timeout=600000 --test-concurrency=1 images/*.spec.ts"
  },
  "nx": {
    "targets": {
      "test:integration": {
        "inputs": [
          "sources",
          "!{projectRoot}/images/**",
          "!{projectRoot}/README.md",
          "^production",
          {
            "runtime": "node --version"
          },
          {
            "env": "SHARNESS_MCP_URL"
          },
          {
            "env": "SHARNESS_PG_TEST_URL"
          }
        ]
      },
      "lint": {
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/eslint.config.ts",
          "{workspaceRoot}/knip.json",
          "{workspaceRoot}/tsconfig.check.json",
          "{workspaceRoot}/scripts/**/*.ts",
          {
            "runtime": "node --version"
          }
        ]
      },
      "test:live": {
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      }
    }
  },
  "devDependencies": {
    "@effect/experimental": "catalog:",
    "@effect/platform": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql": "catalog:",
    "@effect/vitest": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@social-harness/openclaw-channel": "workspace:*",
    "@social-harness/social-harness": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "effect": "catalog:",
    "eslint": "catalog:",
    "jose": "catalog:",
    "protobufjs": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
