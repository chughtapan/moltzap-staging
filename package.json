{
  "name": "@social-harness/social-harness",
  "version": "0.0.0",
  "description": "Social Harness daemon: hosts agents, delivers their messages and checks them against each agent's firewall",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/social-harness/social-harness.git"
  },
  "homepage": "https://github.com/social-harness/social-harness#readme",
  "bugs": {
    "url": "https://github.com/social-harness/social-harness/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.6.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "skills",
    "config",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/harness/startup.d.ts",
      "import": "./dist/harness/startup.js"
    },
    "./test": {
      "sharness-test": {
        "types": "./dist/test.d.ts",
        "import": "./dist/test.js"
      }
    }
  },
  "bin": {
    "sharnessd": "./dist/main.js"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "test:integration": "nx run-many -t test:integration",
    "lint": "nx run-many -t lint,arch:check,typecheck,lint:dead-code,lint:agent-files",
    "arch:check": "NODE_OPTIONS=--max-old-space-size=8192 nx run-many -t arch:check",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "nx run-many -t build && nx run-many -t typecheck",
    "check": "pnpm lint && pnpm format:check",
    "docs:dev": "cd docs && mint dev --no-open",
    "docs:open": "cd docs && mint dev",
    "docs:check": "cd docs && mint broken-links",
    "docs:check:mermaid": "nx run @social-harness/social-harness:docs:check:mermaid",
    "prepare": "husky",
    "effect:source": "./scripts/setup/prepare-effect.sh",
    "test:affected": "nx affected -t test",
    "docs:api": "nx run @social-harness/social-harness:docs:api"
  },
  "nx": {
    "includedScripts": [],
    "namedInputs": {
      "default": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/config/**/*",
        "{projectRoot}/skills/**/*",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/safer-architecture.config.json",
        "sharedGlobals"
      ]
    },
    "targets": {
      "build": {
        "command": "node scripts/build/clean-dist.ts && tsc -b",
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/scripts/build/clean-dist.ts"
        ]
      },
      "lint": {
        "command": "eslint src '*.ts' 'images/*.ts' 'scripts/**/*.ts' --cache --max-warnings=0",
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/eslint.config.ts",
          "{workspaceRoot}/knip.json",
          "{workspaceRoot}/tsconfig.check.json",
          "{workspaceRoot}/*.ts",
          "{workspaceRoot}/images/*.ts",
          "{workspaceRoot}/scripts/**/*.ts"
        ]
      },
      "test": {
        "command": "vitest run --project social-harness --project docs-tooling",
        "inputs": [
          "sources",
          "^production",
          "{workspaceRoot}/vitest.config.ts",
          "{workspaceRoot}/scripts/docs/**/*.ts",
          "{workspaceRoot}/scripts/docs/mermaid-puppeteer.json"
        ]
      },
      "typecheck": {
        "command": "tsc -p tsconfig.check.json",
        "dependsOn": [
          "build",
          {
            "projects": [
              "@social-harness/openclaw-channel"
            ],
            "target": "build"
          }
        ]
      },
      "test:pack": {
        "command": "node scripts/test-social-harness-package.ts",
        "dependsOn": [
          "build",
          "^build"
        ],
        "cache": false
      },
      "arch:check": {
        "command": "safer-architecture-lsp check ."
      },
      "docs:check:mermaid": {
        "cache": true,
        "inputs": [
          "workspaceFiles"
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": ".",
          "parallel": false,
          "commands": [
            "pnpm exec puppeteer browsers install chrome-headless-shell",
            "node scripts/docs/check-mermaid.ts"
          ]
        }
      },
      "lint:dead-code": {
        "command": "agent-code-guard-knip --treat-config-hints-as-errors",
        "cache": true,
        "inputs": [
          "workspaceFiles"
        ]
      },
      "lint:agent-files": {
        "command": "node scripts/repo/check-agent-files.ts",
        "cache": true,
        "inputs": [
          "workspaceFiles"
        ]
      },
      "test:release": {
        "command": "bash scripts/release/compute-next-version.test.sh",
        "cache": false
      },
      "docs:api": {
        "command": "pnpm exec typedoc --options scripts/docs/typedoc.json",
        "cache": true,
        "dependsOn": [
          {
            "projects": [
              "@social-harness/social-harness",
              "@social-harness/openclaw-channel",
              "@social-harness/nanoclaw-channel"
            ],
            "target": "build"
          }
        ],
        "inputs": [
          "{workspaceRoot}/typedoc.json",
          "{workspaceRoot}/scripts/docs/typedoc.json",
          "{workspaceRoot}/scripts/docs/api.css",
          "{workspaceRoot}/src/**/*.ts",
          "sharedGlobals",
          "{workspaceRoot}/plugins/**/*.ts",
          "{workspaceRoot}/plugins/**/*.json"
        ],
        "outputs": [
          "{workspaceRoot}/out/api"
        ]
      }
    }
  },
  "dependencies": {
    "@effect/opentelemetry": "catalog:",
    "@effect/platform": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/rpc": "catalog:",
    "@effect/sql": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/exporter-trace-otlp-proto": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@opentelemetry/semantic-conventions": "catalog:",
    "@thi.ng/sexpr": "catalog:",
    "canonicalize": "catalog:",
    "effect": "catalog:",
    "jose": "catalog:",
    "kysely": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@chughtapan/safer-architecture-lsp": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@eslint-community/eslint-plugin-eslint-comments": "catalog:",
    "@mermaid-js/mermaid-cli": "catalog:",
    "@types/estree": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "ajv": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-agent-code-guard": "catalog:",
    "fast-check": "catalog:",
    "husky": "catalog:",
    "jiti": "catalog:",
    "mint": "catalog:",
    "nx": "catalog:",
    "oxfmt": "catalog:",
    "puppeteer": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-missing-exports": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
