{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/**/*.spec.ts",
        "vitest*.config.ts",
        "scripts/build/*.ts",
        "scripts/test-*-package.ts",
        "images/*.ts",
        "scripts/docs/check-mermaid.ts",
        "scripts/docs/vitest.config.ts",
        "scripts/docs/*.spec.ts",
        "scripts/repo/check-agent-files.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts",
        "scripts/**/*.ts"
      ],
      "typedoc": {
        "config": [
          "typedoc.json",
          "scripts/docs/typedoc.json"
        ]
      },
      "ignore": [
        "src/vendor/effect-mcp/**"
      ],
      "ignoreDependencies": [
        "@mermaid-js/mermaid-cli",
        "puppeteer"
      ]
    },
    "plugins/nanoclaw": {
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    },
    "plugins/openclaw": {
      "entry": [
        "src/**/*.spec.ts",
        "vitest*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    },
    "tests/integration": {
      "entry": [
        "**/*.spec.ts",
        "firewall/firewall-daemon.ts",
        "**/*vitest*.config.ts",
        "images/nanoclaw-probe.ts"
      ],
      "project": [
        "**/*.ts"
      ]
    },
    "images/openclaw-agent": {
      "entry": [
        "*.spec.ts",
        "configure-channel.ts",
        "patch-openclaw.ts"
      ],
      "project": [
        "*.ts"
      ],
      "ignoreDependencies": [
        "@social-harness/openclaw-channel",
        "openclaw"
      ]
    },
    "images/nanoclaw-agent": {
      "entry": [
        "*.spec.ts",
        "entrypoint.ts",
        "install-channel.ts",
        "preload.ts",
        "session-processes.ts"
      ],
      "project": [
        "*.ts"
      ]
    },
    "images/daemon": {
      "ignoreDependencies": [
        "@social-harness/social-harness",
        "@effect/platform-node",
        "effect"
      ]
    }
  }
}
