{
  "name": "@social-harness/openclaw-agent",
  "private": true,
  "type": "module",
  "dependencies": {
    "@social-harness/openclaw-channel": "workspace:*"
  },
  "files": [
    "package.json"
  ],
  "scripts": {
    "test": "node --test --test-timeout=180000 *.spec.ts",
    "lint": "eslint . --max-warnings=0"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:noop"
      },
      "image:build": {
        "command": "docker buildx build --load --tag social-harness-openclaw:local --file images/openclaw-agent/Dockerfile .",
        "cache": false
      },
      "image:smoke": {
        "command": "bash images/openclaw-agent/smoke.sh social-harness-openclaw:local",
        "cache": false
      }
    }
  },
  "devDependencies": {
    "openclaw": "catalog:"
  }
}
