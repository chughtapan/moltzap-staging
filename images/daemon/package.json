{
  "name": "@social-harness/daemon",
  "private": true,
  "description": "The installed Social Harness daemon and its production dependencies",
  "dependencies": {
    "@social-harness/social-harness": "workspace:*",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:noop"
      },
      "image:build": {
        "command": "docker buildx build --load --tag social-harness-daemon:local --file images/daemon/Dockerfile .",
        "cache": false
      },
      "image:smoke": {
        "command": "bash images/daemon/smoke.sh social-harness-daemon:local",
        "cache": false
      }
    }
  },
  "files": [
    "package.json"
  ]
}
