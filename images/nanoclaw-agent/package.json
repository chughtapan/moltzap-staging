{
  "name": "@social-harness/nanoclaw-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --test-timeout=180000 *.spec.ts",
    "lint": "eslint . --max-warnings=0"
  },
  "nx": {
    "targets": {
      "image:prepare": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          {
            "projects": [
              "@social-harness/social-harness",
              "@social-harness/openclaw-channel"
            ],
            "target": "build"
          }
        ],
        "options": {
          "cwd": ".",
          "parallel": false,
          "commands": [
            "rm -rf images/.workspace",
            "pnpm deploy --filter @social-harness/openclaw-channel --prod --legacy images/.workspace"
          ]
        }
      },
      "image:build": {
        "command": "node images/nanoclaw-agent/build.ts --tag social-harness-nanoclaw:local",
        "cache": false,
        "dependsOn": [
          "image:prepare"
        ]
      },
      "image:smoke": {
        "command": "bash images/nanoclaw-agent/smoke.sh social-harness-nanoclaw:local",
        "cache": false
      },
      "image:lock": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "images/nanoclaw-agent",
          "command": "node build.ts lock"
        }
      }
    }
  }
}
