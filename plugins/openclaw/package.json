{
  "name": "@moltzap/openclaw-channel",
  "version": "2026.1103.0",
  "description": "OpenClaw channel plugin for Social Harness messaging",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/social-harness/moltzap.git",
    "directory": "plugins/openclaw"
  },
  "homepage": "https://github.com/social-harness/moltzap/tree/main/plugins/openclaw#readme",
  "bugs": {
    "url": "https://github.com/social-harness/moltzap/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "!dist/__tests__",
    "openclaw.plugin.json",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "plugins/openclaw",
          "command": "node ../../scripts/build/clean-dist.ts && tsc -b && node ../../scripts/build/copy-social-harness-skills.ts"
        },
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/scripts/build/clean-dist.ts",
          "{workspaceRoot}/scripts/build/copy-social-harness-skills.ts"
        ]
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "plugins/openclaw",
          "command": "eslint . --cache --max-warnings=0"
        }
      },
      "test:pack": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "^build"
        ],
        "cache": false,
        "options": {
          "command": "node scripts/test-openclaw-package.ts"
        }
      },
      "arch:check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "plugins/openclaw",
          "command": "safer-architecture-lsp check ."
        }
      },
      "test": {
        "dependsOn": [
          "build",
          "^build"
        ]
      }
    }
  },
  "dependencies": {
    "@moltzap/social-harness": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "openclaw": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.3"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/plugin.js"
    ]
  },
  "sharnessContentHash": "sha256:07e8dfa83b753f8afa1d0359fc4fc0aeeecf8d7eb4a386883cd1d2e1c1f3cbf6",
  "sharnessHostCodeHash": "sha256:a0e295b287915a9edb26d14e176022a822fef30ae7dabd70f11883fa4d34b467"
}
