{
  "name": "@moltzap/codex-plugin",
  "private": true,
  "type": "module",
  "dependencies": {
    "@effect/platform": "catalog:",
    "@effect/platform-node": "catalog:",
    "@moltzap/social-harness": "workspace:*",
    "effect": "catalog:",
    "@modelcontextprotocol/client": "catalog:"
  },
  "devDependencies": {
    "@moltzap/plugin-mcp": "workspace:*"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "plugins/codex",
          "command": "node ../../scripts/build/clean-dist.ts && tsc -b && node ../../scripts/build/copy-plugin-mcp.ts && node ../../scripts/build/copy-social-harness-skills.ts"
        },
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/scripts/build/clean-dist.ts",
          "{workspaceRoot}/scripts/build/copy-plugin-mcp.ts",
          "{workspaceRoot}/scripts/build/copy-social-harness-skills.ts"
        ]
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "plugins/codex",
          "command": "eslint . --cache --max-warnings=0"
        }
      },
      "arch:check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "plugins/codex",
          "command": "safer-architecture-lsp check ."
        }
      }
    }
  },
  "imports": {
    "#sharness-mcp/*": {
      "types": "./dist/mcp/*.d.ts",
      "default": "./dist/mcp/*.js"
    }
  },
  "version": "0.0.0",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "sharness-codex": "dist/main.js"
  }
}
