{
  "name": "@social-harness/nanoclaw-channel",
  "version": "0.0.0",
  "private": true,
  "description": "NanoClaw channel adapter for Social Harness messaging",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/social-harness/social-harness.git"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "main": "./dist/channels/sharness.js",
  "types": "./dist/channels/sharness.d.ts",
  "exports": {
    ".": {
      "types": "./dist/channels/sharness.d.ts",
      "import": "./dist/channels/sharness.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.ts && tsc -b",
    "lint": "eslint . --cache --max-warnings=0",
    "test": "vitest run --root ../.. --project nanoclaw-channel"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/scripts/clean-dist.ts"
        ]
      },
      "test": {
        "dependsOn": [
          "build",
          "^build"
        ]
      },
      "arch:check": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "plugins/nanoclaw",
          "command": "safer-architecture-lsp check ."
        }
      }
    }
  },
  "dependencies": {
    "@social-harness/social-harness": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
