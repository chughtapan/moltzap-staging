{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "rootDir": "src",
    "paths": {
      "#sharness-mcp/*": [
        "../shared/*.ts"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ],
  "references": [
    {
      "path": "../../packages/social-harness"
    },
    {
      "path": "../shared"
    }
  ]
}
