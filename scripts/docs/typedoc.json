{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Social Harness API",
  "customCss": "api.css",
  "entryPointStrategy": "packages",
  "plugin": ["typedoc-plugin-missing-exports"],
  "entryPoints": ["../..", "../../plugins/nanoclaw", "../../plugins/openclaw"],
  "packageOptions": {
    "excludeExternals": true,
    "externalPattern": ["**/node_modules/**", "**/dist/**"],
    "internalModule": "Referenced types",
    "entryPoints": [
      "src/index.ts"
    ],
    "excludeInternal": true,
    "excludePrivate": true,
    "readme": "none",
    "skipErrorChecking": true,
    "blockTags": [
      "@file",
      "@param",
      "@returns",
      "@throws",
      "@example",
      "@deprecated",
      "@see",
      "@internal",
      "@module"
    ]
  },
  "outputs": [
    {
      "name": "html",
      "path": "../../out/api"
    }
  ],
  "readme": "none",
  "ignoredHighlightLanguages": ["mermaid"],
  "skipErrorChecking": true,
  "logLevel": "Warn"
}
