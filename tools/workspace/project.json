{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "workspace",
  "targets": {
    "format": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "oxfmt ."
      }
    },
    "format:check": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "oxfmt --check ."
      }
    },
    "docs:check:mermaid": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "parallel": false,
        "commands": [
          "pnpm exec puppeteer browsers install chrome-headless-shell",
          "node scripts/docs/check-mermaid.ts"
        ]
      }
    },
    "lint:typescript": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "parallel": false,
        "commands": [
          "tsc --noEmit -p tsconfig.eslint.json",
          "tsc --noEmit -p scripts/tsconfig.json"
        ]
      }
    },
    "lint:dead-code": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "agent-code-guard-knip --treat-config-hints-as-errors"
      }
    },
    "lint:root": {
      "cache": false,
      "dependsOn": [
        "lint:typescript",
        "lint:dead-code"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "node -e \"\""
      }
    },
    "lint": {
      "cache": false,
      "dependsOn": [
        "lint:root",
        "lint:agent-files",
        {
          "target": "arch:check",
          "projects": "@social-harness/*"
        },
        {
          "target": "lint",
          "projects": "@social-harness/*"
        },
        {
          "target": "lint",
          "projects": "@social-harness/*"
        },
        {
          "target": "typecheck",
          "projects": "@social-harness/*"
        }
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "node -e \"\""
      }
    },
    "lint:agent-files": {
      "cache": true,
      "inputs": [
        "workspaceFiles"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "node scripts/repo/check-agent-files.ts"
      }
    },
    "test": {
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/docs/**/*.ts",
        "{workspaceRoot}/scripts/docs/mermaid-puppeteer.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "pnpm exec vitest run --config scripts/docs/vitest.config.ts"
      }
    },
    "test:release": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash scripts/release/compute-next-version.test.sh"
      }
    },
    "docs:api": {
      "cache": true,
      "dependsOn": [
        {
          "projects": [
            "@social-harness/social-harness",
            "@social-harness/openclaw-channel",
            "@social-harness/nanoclaw-channel"
          ],
          "target": "build"
        }
      ],
      "inputs": [
        "{workspaceRoot}/typedoc.json",
        "{workspaceRoot}/scripts/docs/typedoc.json",
        "{workspaceRoot}/scripts/docs/api.css",
        "{workspaceRoot}/tsconfig*.json",
        "{workspaceRoot}/src/**/*.ts",
        "sharedGlobals",
        "{workspaceRoot}/plugins/**/*.ts",
        "{workspaceRoot}/plugins/**/*.json"
      ],
      "outputs": [
        "{workspaceRoot}/out/api"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "pnpm exec typedoc --options scripts/docs/typedoc.json"
      }
    }
  }
}
